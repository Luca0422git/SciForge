{
  "id": "blend_insert_chamfer_before_fillet",
  "title": "Fillet the front edge r2, roll the marker back, insert a chamfer on the right edge before it",
  "tags": [
    "fillet",
    "chamfer",
    "blend",
    "timeline",
    "rollback",
    "reference"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            40,
            30
          ],
          "name": "base"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "blend_fillet",
      "id": "f1",
      "radius": 2,
      "edges": {
        "type": "line",
        "parallel": [
          1,
          0,
          0
        ],
        "at": [
          {
            "axis": "z",
            "value": "max"
          },
          {
            "axis": "y",
            "value": "min"
          }
        ],
        "count": 1
      }
    },
    {
      "op": "check",
      "expect": {
        "volume": 11965.663706143592,
        "source": "analytic",
        "note": "12000 - 40 * 2^2 (1 - pi/4)"
      }
    },
    {
      "op": "roll",
      "after": "e1"
    },
    {
      "op": "blend_insert",
      "id": "c1",
      "kind": "chamfer",
      "distance": 1,
      "edges": {
        "type": "line",
        "parallel": [
          0,
          1,
          0
        ],
        "at": [
          {
            "axis": "z",
            "value": "max"
          },
          {
            "axis": "x",
            "value": "max"
          }
        ],
        "count": 1
      },
      "comment": "goes in before f1; f1's edge, now 1 mm shorter, must still be found"
    },
    {
      "op": "roll",
      "end": true
    }
  ],
  "expect": {
    "volume": 11951.160025034631,
    "faces": 8,
    "bbox": [
      0,
      0,
      0,
      40,
      30,
      10
    ],
    "source": "analytic",
    "note": "chamfer 1 on the 30 mm right edge: 30 * 1/2. The r2 round (cross-section A = 4 - pi) runs 40 mm but its last part is cut by the chamfer plane x + z = 49 for z > 9: it removes 40 A - M with M = int_9^10 (z - 9) w(z) dz = 1 - 3 sqrt(3)/2 + 2 pi/3 (w = width of the round's cross-section at height z). V = 12000 - 15 - 40 (4 - pi) + M = 11825 + 40 pi + 1 + 2 pi/3 - 3 sqrt(3)/2"
  }
}
