{
  "id": "modify2_pattern_multibody_cut",
  "title": "Two boxes, one cut through both, repeated 3 times: the copies cut both bodies",
  "tags": [
    "pattern",
    "multi-body",
    "extrude",
    "fusion-dialog"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            20,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "sketch",
      "id": "s2",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            30,
            0,
            50,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e2",
      "profile": "s2",
      "distance": 10,
      "operation": "new_body"
    },
    {
      "op": "use_body",
      "step": "e1",
      "comment": "the next sketch belongs to Body1"
    },
    {
      "op": "sketch",
      "id": "s3",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            10,
            2,
            40,
            6
          ]
        }
      ],
      "offset": 10
    },
    {
      "op": "extrude",
      "id": "x1",
      "profile": "s3",
      "distance": 5,
      "flip": true,
      "operation": "cut",
      "bodies": "auto"
    },
    {
      "op": "rectangular_pattern",
      "id": "p1",
      "features": [
        "x1"
      ],
      "direction": "Y",
      "quantity": 3,
      "distance": 12
    },
    {
      "op": "expect_bodies",
      "bodies": {
        "e1": {
          "volume": 3400,
          "solids": 1
        },
        "e2": {
          "volume": 3400,
          "solids": 1
        }
      }
    },
    {
      "op": "measure_bodies",
      "steps": [
        "e1",
        "e2"
      ]
    }
  ],
  "expect": {
    "volume": 6800,
    "solids": 2,
    "bbox": [
      0,
      0,
      0,
      50,
      20,
      10
    ],
    "source": "analytic",
    "note": "Each box 20*20*10 = 4000. The slot x 10..40, y 2..6, z 5..10 cuts 10*4*5 = 200 from each; the pattern repeats it at y + 6 and y + 12 in both bodies (Fusion repeats the extrude's change in every body it made): each box loses 3*200 = 600, 3400 each."
  }
}