{
  "id": "inspect_three_points_oblique_hole",
  "title": "Box, Point at Vertex, Plane Through Three Points (two corners + that point), a circle r 2 on the slanted plane cut symmetric 20 through the box",
  "tags": [
    "construct",
    "three-points",
    "construction-point",
    "sketch-on-plane",
    "measure"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [0, 0, 40, 30],
          "name": "base"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "construct",
      "id": "p1",
      "preset": "PointVertex",
      "refs": [{"vertex": [40, 0, 0]}]
    },
    {
      "op": "construct",
      "id": "p2",
      "preset": "PlaneThreePoints",
      "refs": [{"vertex": [0, 0, 10]}, {"vertex": [40, 30, 10]}, {"construct": "p1"}]
    },
    {
      "op": "construct_expect",
      "target": "p2",
      "point": [24, 9, 7],
      "normal": [-3, 4, -12]
    },
    {
      "op": "measure_expect",
      "a": {"construct": "p1"},
      "b": {"construct": "p2"},
      "distance": 0
    },
    {
      "op": "measure_expect",
      "a": {"construct": "p2"},
      "b": {
        "edge": {
          "type": "line",
          "parallel": [1, 0, 0],
          "at": [{"axis": "y", "value": 0}, {"axis": "z", "value": 10}],
          "count": 1
        }
      },
      "distance": 0,
      "angle": 13.342363797088238
    },
    {
      "op": "construct_extrude",
      "id": "e2",
      "plane": "p2",
      "circles": [[24, 9, 7, 2]],
      "distance": 20,
      "direction": "symmetric",
      "operation": "cut"
    }
  ],
  "expect": {
    "volume": 11863.864318344442,
    "faces": 7,
    "bbox": [0, 0, 0, 40, 30, 10],
    "source": "analytic",
    "note": "The plane through (0,0,10), (40,30,10) and (40,0,0) has normal (-3,4,-12)/13 and holds (24,9,7). The front top edge meets it at (0,0,10) at asin(3/13) = 13.342 deg. The circle r 2 there, cut 10 each way along the normal, makes a slanted hole from the top face to the bottom face (both ends inside them): its length along the axis between z = 0 and z = 10 is 10 * 13/12, so it removes pi * 2^2 * 130/12 = 136.136. Faces: the box's 6 + the hole's wall."
  }
}
