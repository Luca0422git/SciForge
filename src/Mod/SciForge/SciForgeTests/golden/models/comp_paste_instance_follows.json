{
  "id": "comp_paste_instance_follows",
  "title": "Copy / Paste of a component: the linked instance follows an edit of the original",
  "tags": [
    "components",
    "paste"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
