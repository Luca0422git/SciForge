    {
      "op": "parameter",
      "name": "pitch_q",
      "value": 5,
      "unit": "mm"
    },
    {
      "op": "sf_coil",
      "id": "c1",
      "plane": "XY",
      "diameter": 20,
      "section_size": 2,
      "section": "circular",
      "section_position": "inside",
      "type": "height_pitch",
      "height": 20,
      "pitch": 5,
      "angle": -10,
      "expressions": {
        "height": "rise_h",
        "pitch": "pitch_q"
      }
    },
    {
      "op": "parameter",
      "name": "rise_h",
      "value": 24
    },
    {
      "op": "parameter",
      "name": "pitch_q",
      "value": 6
    }
