  "expect": {
    "volume": 543.5448725746517,
    "rel_tol": 0.0001,
    "solids": 1,
    "note": "After the change: 24 mm of pitch 6 = 4 turns, narrowing by 10 deg: V = pi x 2 pi x 4 x (9 - 12 tan 10). The section's turns are worked out from the two parameters (height / pitch), so it still ends where the coil begins. The helix is an approximation, hence rel_tol 1e-4.",
    "source": "analytic"
  }
