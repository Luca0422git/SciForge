{
  "id": "extrude_multi_move_refused",
  "title": "A fillet in Body2 after a multi-body cut cannot be dragged before the cut",
  "tags": [
    "extrude",
    "bodies",
    "multi_body"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            20,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "sketch",
      "id": "s2",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            30,
            0,
            50,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e2",
      "profile": "s2",
      "distance": 10,
      "operation": "new_body"
    },
    {
      "op": "use_body",
      "step": "e1",
      "comment": "the next sketch belongs to Body1"
    },
    {
      "op": "sketch",
      "id": "s3",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            10,
            5,
            40,
            15
          ]
        }
      ],
      "offset": 10
    },
    {
      "op": "extrude",
      "id": "x1",
      "profile": "s3",
      "distance": 5,
      "flip": true,
      "operation": "cut",
      "bodies": "auto"
    },
    {
      "op": "use_body",
      "step": "e2"
    },
    {
      "op": "blend_fillet",
      "id": "f1",
      "radius": 1,
      "edges": {
        "type": "line",
        "parallel": [
          0,
          0,
          1
        ],
        "at": [
          {
            "axis": "x",
            "value": 50
          },
          {
            "axis": "y",
            "value": 20
          }
        ],
        "count": 1
      }
    },
    {
      "op": "expect_move_refused",
      "target": "f1",
      "before": "x1",
      "reason": "several bodies"
    },
    {
      "op": "expect_bodies",
      "bodies": {
        "e1": {
          "volume": 3500,
          "solids": 1
        },
        "e2": {
          "volume": 3497.8539816339744,
          "solids": 1
        }
      }
    },
    {
      "op": "measure_bodies",
      "steps": [
        "e1",
        "e2"
      ]
    }
  ],
  "expect": {
    "volume": 6997.853981633974,
    "solids": 2,
    "bbox": [
      0,
      0,
      0,
      50,
      20,
      10
    ],
    "source": "analytic",
    "note": "Both boxes cut (3500 each); Body2's outer corner edge (x 50, y 20, 10 long) rounded r1 removes 10 * (1 - pi/4). The refused move changes nothing."
  }
}
