        "count": 1
      },
      "target": {
        "face": {
          "type": "cylinder",
          "count": 1
        },
        "of": "e2"
      }
    }
  ],
  "expect": {
    "area": 1494.3000607972044,
    "faces": 5,
    "solids": 0,
    "rel_tol": 1e-06,
    "source": "analytic",
    "note": "the floor: 30 x the arc 2 x 42 asin(10 / 42); the side walls 200 - the area under the arch (int of -40 + sqrt(42^2 - t^2), t -10..10); the front and back walls 30 x (10 - 0.7922)"
  }
