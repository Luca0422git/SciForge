{
  "id": "edit_extrude_then_shell",
  "title": "Shelled box whose extrude height is edited 30 -> 50",
  "tags": [
    "reference-stability",
    "edit",
    "shell"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            60,
            40
          ],
          "name": "base"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 30
    },
    {
      "op": "shell",
      "id": "sh1",
      "thickness": 2,
      "faces": {
        "normal": [
          0,
          0,
          1
        ],
        "count": 1
      }
    },
    {
      "op": "edit",
      "target": "e1",
      "set": {
        "distance": 50
      }
    }
  ],
  "expect": {
    "volume": 23232,
    "faces": 11,
    "bbox": [
      0,
      0,
      0,
      60,
      40,
      50
    ],
    "source": "analytic",
    "note": "The shell must still remove the (moved) top face: V = 60*40*50 - 56*36*48"
  }
}
