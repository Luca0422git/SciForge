{
  "id": "extrude_multi_join_delete",
  "title": "Join merging two bodies, suppressed, unsuppressed and deleted: Body2 comes back",
  "tags": [
    "extrude",
    "bodies",
    "multi_body"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            20,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "sketch",
      "id": "s2",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            30,
            0,
            50,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e2",
      "profile": "s2",
      "distance": 10,
      "operation": "new_body"
    },
    {
      "op": "use_body",
      "step": "e1",
      "comment": "the next sketch belongs to Body1"
    },
    {
      "op": "sketch",
      "id": "s3",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            10,
            5,
            40,
            15
          ]
        }
      ],
      "offset": 5
    },
    {
      "op": "extrude",
      "id": "x1",
      "profile": "s3",
      "distance": 10,
      "operation": "join",
      "bodies": "auto"
    },
    {
      "op": "suppress",
      "target": "x1"
    },
    {
      "op": "expect_bodies",
      "bodies": {
        "e1": {
          "volume": 4000,
          "solids": 1
        },
        "e2": {
          "volume": 4000,
          "solids": 1
        }
      }
    },
    {
      "op": "unsuppress",
      "target": "x1"
    },
    {
      "op": "expect_bodies",
      "bodies": {
        "e1": {
          "volume": 10000,
          "solids": 1
        }
      },
      "used_up": [
        "e2"
      ]
    },
    {
      "op": "delete",
      "target": "x1"
    },
    {
      "op": "expect_bodies",
      "bodies": {
        "e1": {
          "volume": 4000,
          "solids": 1
        },
        "e2": {
          "volume": 4000,
          "solids": 1
        }
      }
    },
    {
      "op": "measure_bodies",
      "steps": [
        "e1",
        "e2"
      ]
    }
  ],
  "expect": {
    "volume": 8000,
    "solids": 2,
    "bbox": [
      0,
      0,
      0,
      50,
      20,
      10
    ],
    "source": "analytic",
    "note": "After the delete Body1 and Body2 are the two boxes again."
  }
}
