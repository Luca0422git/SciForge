{
  "id": "sf_shell_swap_presspull_follows",
  "title": "Shell inside 2 (FreeCAD's Thickness), Press Pull on the front wall, the shell edited to Both 1 out (SciForge's shell): the Press Pull keeps its wall",
  "tags": [
    "shell",
    "sciforge-shell",
    "edit",
    "press-pull",
    "reference-stability"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            40,
            30
          ],
          "name": "base"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "sf_shell",
      "id": "sh1",
      "faces": {
        "normal": [
          0,
          0,
          1
        ],
        "count": 1
      },
      "inside": 2
    },
    {
      "op": "press_pull",
      "id": "pp1",
      "faces": {
        "normal": [
          0,
          -1,
          0
        ],
        "at": {
          "axis": "y",
          "value": 0
        },
        "count": 1
      },
      "distance": 2
    },
    {
      "op": "check",
      "expect": {
        "volume": 5312,
        "source": "analytic"
      }
    },
    {
      "op": "sf_shell_edit",
      "target": "sh1",
      "set": {
        "direction": "both",
        "outside": 1
      }
    }
  ],
  "expect": {
    "volume": 8220,
    "bbox": [
      -1,
      -3,
      -1,
      41,
      31,
      10
    ],
    "solids": 1,
    "source": "analytic",
    "note": "Inside 2: 12000 - 36*26*8 = 4512, front wall pulled 2: + 40*10*2 = 5312. Both 2/1: 42*32*11 - 36*26*8 = 7296, the moved wall (42 x 11) pulled 2: + 924 = 8220. Before the QA fix the Press Pull lost its face when FreeCAD's Thickness was swapped for SciForge's shell."
  }
}
