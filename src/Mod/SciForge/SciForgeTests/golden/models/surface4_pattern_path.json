      "quantity": 3,
      "distance": 40
    },
    {
      "op": "measure_bodies",
      "steps": [
        "pp"
      ],
      "comment": "the two copies"
    }
  ],
  "expect": {
    "area": 3200,
    "faces": 10,
    "solids": 0,
    "bbox": [
      20,
