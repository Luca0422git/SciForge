{
  "id": "bodies_combine_new_body_target_deleted",
  "title": "Combine Join with New Body, then the (used-up) target body is deleted: the new body keeps its shape",
  "tags": [
    "bodies",
    "combine",
    "new-body",
    "delete"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            40,
            30
          ],
          "name": "s1r"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "sketch",
      "id": "s2",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            30,
            0,
            70,
            30
          ],
          "name": "s2r"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e2",
      "profile": "s2",
      "distance": 10,
      "operation": "new_body"
    },
    {
      "op": "combine",
      "id": "c1",
      "target": "e1",
      "tools": [
        "e2"
      ],
      "operation": "join",
      "new_body": true
    },
    {
      "op": "delete_bodies",
      "steps": [
        "e1"
      ]
    },
    {
      "op": "delete_bodies",
      "steps": [
        "e2"
      ]
    }
  ],
  "expect": {
    "volume": 21000,
    "area": 6200,
    "faces": 6,
    "solids": 1,
    "bbox": [
      0,
      0,
      0,
      70,
      30,
      10
    ],
    "source": "analytic",
    "note": "as bodies_combine_new_body (70x30x10); both bodies it was made from are gone, the new body keeps them as they were"
  }
}
