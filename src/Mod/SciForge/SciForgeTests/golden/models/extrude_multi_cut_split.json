{
  "id": "extrude_multi_cut_split",
  "title": "A slot cut through both bodies splits Body2 into two pieces",
  "tags": [
    "extrude",
    "bodies",
    "multi_body"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            20,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 10
    },
    {
      "op": "sketch",
      "id": "s2",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            30,
            0,
            50,
            20
          ]
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e2",
      "profile": "s2",
      "distance": 10,
      "operation": "new_body"
    },
    {
      "op": "use_body",
      "step": "e1",
      "comment": "the next sketch belongs to Body1"
    },
    {
      "op": "sketch",
      "id": "s3",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            10,
            8,
            60,
            12
          ]
        }
      ],
      "offset": 10
    },
    {
      "op": "extrude",
      "id": "x1",
      "profile": "s3",
      "distance": 5,
      "flip": true,
      "extent": "through_all",
      "operation": "cut",
      "bodies": "auto"
    },
    {
      "op": "expect_bodies",
      "bodies": {
        "e1": {
          "volume": 3600,
          "solids": 1
        },
        "e2": {
          "volume": 3200,
          "solids": 2
        }
      }
    },
    {
      "op": "measure_bodies",
      "steps": [
        "e1",
        "e2"
      ]
    }
  ],
  "expect": {
    "volume": 6800,
    "solids": 3,
    "bbox": [
      0,
      0,
      0,
      50,
      20,
      10
    ],
    "source": "analytic",
    "note": "Slot y 8..12 through everything: Body1 loses 10*4*10 = 400; Body2 loses 20*4*10 = 800 and falls into two 20*8*10 pieces."
  }
}
