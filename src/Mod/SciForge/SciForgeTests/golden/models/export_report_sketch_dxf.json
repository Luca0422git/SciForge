{
  "id": "export_report_sketch_dxf",
  "title": "Export report: what Save As DXF leaves out of a sketch (dimensions, constraints, construction, points, reference curves, its place in 3D)",
  "tags": [
    "export",
    "export-report",
    "dxf",
    "sketch"
  ],
  "steps": [
    {
      "op": "sketch",
      "id": "s1",
      "plane": "XY",
      "geometry": [
        {
          "rect": [
            0,
            0,
            40,
            30
          ],
          "name": "plate"
        },
        {
          "circle": [
            20,
            15,
            5
          ],
          "name": "hole"
        }
      ]
    },
    {
      "op": "extrude",
      "id": "e1",
      "profile": "s1",
      "distance": 5
    },
    {
      "op": "export_report_expect",
      "format": "DXF",
      "target": "s1",
      "expect": {
        "dimensions": 7,
        "constraints": 8
      },
      "comment": "rectangle + circle on XY: 4 + 3 dimensions, 4 coincident + 2 horizontal + 2 vertical; nothing else is lost"
    },
    {
      "op": "sketch",
      "id": "s2",
      "plane": "XZ",
      "geometry": [
        {
          "rect": [
            0,
            0,
            20,
            10
          ],
          "name": "side"
        },
        {
          "ellipse": [
            40,
            5,
            6,
            3
          ]
        }
      ]
    },
    {
      "op": "sketch_extras",
      "target": "s2",
      "points": [
        [
          2,
          2
        ],
        [
          4,
          4
        ]
      ],
      "construction": [
        [
          0,
          0,
          20,
          10
        ]
      ]
    },
    {
      "op": "export_report_expect",
      "format": "DXF",
      "target": "s2",
      "expect": {
        "dimensions": 4,
        "constraints": 8,
        "construction_curves": 1,
        "points": 2,
        "off_plane": 1
      },
      "comment": "on XZ (the DXF is flat in the sketch's own X and Y), with 2 points and a construction line"
    },
    {
      "op": "sketch",
      "id": "s3",
      "face": {
        "normal": [
          0,
          0,
          1
        ],
        "count": 1
      },
      "auto_project": true,
      "geometry": [
        {
          "circle": [
            10,
            10,
            3
          ],
          "name": "pin"
        }
      ]
    },
    {
      "op": "export_report_expect",
      "format": "DXF",
      "target": "s3",
      "expect": {
        "dimensions": 3,
        "off_plane": 1
      },
      "comment": "on e1's top face with Auto project (on by default): the face's 5 edges are projected as defining curves, so they are curves of the sketch and the DXF has them (the round trip counts them): no projected curve is reported lost (review F4); the pin's 3 dimensions and its place in 3D are"
    },
    {
      "op": "sketch_extras",
      "target": "s3",
      "references": [
        [
          "e1",
          "Edge3"
        ],
        [
          "e1",
          "Edge14"
        ]
      ],
      "comment": "two of e1's bottom edges (a line and the hole's circle) projected as references only (not defining)"
    },
    {
      "op": "export_report_expect",
      "format": "DXF",
      "target": "s3",
      "expect": {
        "dimensions": 3,
        "projected": 2,
        "off_plane": 1
      },
      "comment": "the 2 reference curves are not in the DXF: 2 projected curves (curves, not the references they come from)"
    }
  ],
  "expect": {
    "volume": 5607.300918301276,
    "solids": 1,
    "bbox": [
      0,
      0,
      0,
      40,
      30,
      5
    ],
    "source": "analytic",
    "note": "40 x 30 x 5 = 6000 minus the hole pi * 5^2 * 5 = 392.699; the DXF checks are the point of this model"
  }
}
