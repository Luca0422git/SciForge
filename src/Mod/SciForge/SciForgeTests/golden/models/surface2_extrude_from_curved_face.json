    "faces": 1,
    "solids": 0,
    "bbox": [
      0,
      0,
      -16.771243444677047,
      30,
      0,
      0
    ],
    "abs_tol": 0.001,
    "source": "analytic",
    "note": "Each line starts on the cylinder's top (axis along Y at x 15, z -30, r 20: z = -30 + sqrt(400 - (x - 15)^2), the crossing nearest the profile) and goes up 10: a band 10 high over the 30 long line, area 30 x 10 whatever the start curve"
  }
