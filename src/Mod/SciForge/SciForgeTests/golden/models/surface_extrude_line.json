{
  "id": "surface_extrude_line",
  "title": "SURFACE Extrude of an open sketch line, 10 each way (Symmetric)",
  "tags": [
    "surface",
    "extrude"
  ],
  "steps": [
    {
      "op": "sf_curves",
      "id": "s1",
