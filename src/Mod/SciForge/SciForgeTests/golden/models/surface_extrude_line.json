      ],
      "options": {
        "distance": 10,
        "direction": "symmetric"
      }
    }
  ],
  "expect": {
    "area": 600,
    "faces": 1,
    "solids": 0,
    "bbox": [
      0,
      0,
      -10,
      30,
      0,
      10
    ],
    "source": "analytic",
    "note": "a 30 long line swept 10 up and 10 down: one flat face 30 x 20 = 600"
  }
}
